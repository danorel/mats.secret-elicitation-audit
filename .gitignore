# results/user_gender/ stays ignored except the two small mean-delta vectors committed in session 8
# (semantic_null_cosine_control.py reads them; regenerating them needs a GPU)
!/results/
/results/*
!/results/user_gender/
/results/user_gender/*
!/results/user_gender/mean_delta_vectors/

# figures are tracked (like bridge-jspace): the PNGs, their styles-plot sidecars and the status registry; the
# numbers they read stay in results/ (ignored above; HF dataset danorel/mats.esk-audit)
!figures/**/*.png
!figures/**/*.styles.json
!figures/status.csv

